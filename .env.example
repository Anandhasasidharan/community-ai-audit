# Community AI Audit - Environment Template
# Copy to .env and fill values as needed.

# ---------------------------
# Core
# ---------------------------
COMMUNITY_AI_AUDIT_CONFIG=
COMMUNITY_AI_AUDIT_PLUGIN_PATH=
COMMUNITY_AI_AUDIT_LOG_LEVEL=INFO

# ---------------------------
# Splunk HEC
# ---------------------------
SPLUNK_HEC_URL=https://your-splunk-host:8088
SPLUNK_HEC_TOKEN=

# ---------------------------
# Elastic
# ---------------------------
ELASTICSEARCH_URL=https://your-elastic-host:9200
# Use either API key OR username/password
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ---------------------------
# Datadog
# ---------------------------
DD_SITE=datadoghq.com
DD_API_KEY=
DD_APP_KEY=

# ---------------------------
# Sentinel / Log Analytics
# ---------------------------
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
AZURE_LOG_ANALYTICS_KEY=

# ---------------------------
# Model Providers (optional)
# ---------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
AWS_PROFILE=
AWS_REGION=us-east-1
